# weby.cash PWA — backend endpoints for the LOCAL dev stack.
# Copy to `.env` for local dev (`.env` is gitignored). All vars are PUBLIC_*
# so SvelteKit exposes them to the client (this is an SSR-off SPA).

# Webycash referee (trustless-exchange mediator). Local stack: :8090.
PUBLIC_REFEREE_URL=http://localhost:8090

# Extro keyserver (identity bootstrap + swap push). Local stack: :7800.
PUBLIC_KEYSERVER_URL=http://localhost:7800

# extro-node adapter mode: 'bundled' (same-realm WASM, real wallet ops) |
# 'mock' (deterministic in-memory) | 'cross-domain' (extro.network bridge,
# pre-production). Defaults to 'bundled' in the browser when unset.
PUBLIC_EXTRO_ADAPTER=bundled

# ── Rail endpoints (Op::Rail server URLs + esplora) ──────────────────────────
# Per-NetworkMode (TESTNET / PRODUCTION). All optional — each falls back to the
# built-in default in src/lib/extro/config.ts. testnet maps to WireNetwork
# `Signet`; production maps to `Bitcoin`. Esplora MUST be CORS-open (the wasm
# fetch bridge calls it from the browser).
#
# Testnet defaults: local rail stack + blockstream signet esplora.
# PUBLIC_RAIL_TESTNET_ESPLORA_URL=https://blockstream.info/signet/api
# PUBLIC_RAIL_TESTNET_VOUCHER_URL=http://localhost:8183
# PUBLIC_RAIL_TESTNET_RGB_URL=http://localhost:8182
# PUBLIC_RAIL_TESTNET_WEBCASH_URL=http://localhost:8181
#
# Production defaults: public production servers + blockstream mainnet esplora.
# PUBLIC_RAIL_PRODUCTION_ESPLORA_URL=https://blockstream.info/api
# PUBLIC_RAIL_PRODUCTION_VOUCHER_URL=https://voucher.weby.cash
# PUBLIC_RAIL_PRODUCTION_RGB_URL=https://rgb.weby.cash
# PUBLIC_RAIL_PRODUCTION_WEBCASH_URL=https://webcash.weby.cash
