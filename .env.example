# Local Vite development only. Deployed builds load the same explicit shape
# from /wallet/runtime-config.json, generated by dev-worker.js from versioned
# Wrangler variables. Copy to .env; never put private keys or long-lived TURN
# credentials here (browser runtime configuration is public by definition).

PUBLIC_BOOT_SCHEMA_VERSION=1
PUBLIC_DEPLOYMENT=development
PUBLIC_EXTRO_DB_NAME=extro-node-local
PUBLIC_EXTRO_ADAPTER=bundled

PUBLIC_KEYSERVER_URL=http://localhost:7800
PUBLIC_KEYSERVER_DOMAIN=localhost
PUBLIC_KEYSERVER_FINGERPRINT=1111111111111111111111111111111111111111
PUBLIC_KEYSERVER_VK=2222222222222222222222222222222222222222222222222222222222222222
PUBLIC_REFEREE_URL=http://localhost:8090
PUBLIC_REFEREE_VK=3333333333333333333333333333333333333333333333333333333333333333

PUBLIC_WEBCASH_SERVER_URL=http://localhost:8181
PUBLIC_VOUCHER_SERVER_URL=http://localhost:8183
PUBLIC_RGB_SERVER_URL=http://localhost:8182
PUBLIC_RGB_COLLECTIBLE_SERVER_URL=http://localhost:8184

PUBLIC_ARK_ENABLED=false
PUBLIC_ARK_NETWORK=regtest
PUBLIC_ARK_ASP_URL=
PUBLIC_ARK_OWNER_PK_HEX=

PUBLIC_ZKP_PROFILE=development-only
PUBLIC_ZKP_BEARER_VK_SHA256=ecd299b3326e682106a31a39decf1fb43c0d5b960eb40baa2975691f406f77c1
PUBLIC_ZKP_CONDITIONAL_VK_SHA256=8efdd75f738658f3da0308fac3cbf6912c1324e815d863548c7e82ba39d07f1d
PUBLIC_ICE_SERVERS_JSON=["stun:stun.cloudflare.com:3478"]
PUBLIC_TURN_SERVERS_JSON=[{"url":"turn:openrelay.metered.ca:443","username":"openrelayproject","credential":"openrelayproject"}]
